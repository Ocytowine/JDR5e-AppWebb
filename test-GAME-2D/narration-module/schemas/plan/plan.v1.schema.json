{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narration-module/plan.v1.schema.json",
  "title": "Plan Contract v1",
  "type": "object",
  "required": [
    "objective",
    "approach",
    "assumptions",
    "checks_needed",
    "resources_to_spend",
    "risks",
    "fallbacks",
    "need_clarification"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks_needed": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resources_to_spend": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "need_clarification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

