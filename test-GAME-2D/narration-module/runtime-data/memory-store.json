      "events": [],
      "relations": [],
      "knowledge": {
        "player_view": [
          {
            "turn_id": "turn-ec532c5f-239c-4e6b-a369-83818d36898c",
            "text": "Vous vous trouvez dans les Halles des Commerces de Lysenthe. Autour de vous s'étendent de vastes galeries où s'enchaînent entrepôts, comptoirs et étals. L'activité commerciale est intense, avec des négociations qui semblent continuellement animées. L'endroit est éclairé par la lumière claire du fin d'après-midi, et l'air est ponctué par des bruits de voix et le bruissement des commerces. Vous distinguez deux points d'intérêt majeurs : le marché de gros et de détail ainsi qu'une plateforme logistique. Depuis ici, vous avez aussi un accès apparent vers le port des Xantars et la maison des Registres.",
            "knowledge_kind": "summary",
            "certainty": "partial",
            "source": "auto_narration",
            "location_id": "halles_des_commerces",
            "linked_entity_ids": [
              "halles_des_commerces",
              "marche de gros et de detail",
              "plateforme logistique"
            ],
            "tags": [
              "observe",
              "auto_summary"
            ]
          },
          {
            "turn_id": "turn-ec532c5f-239c-4e6b-a369-83818d36898c",
            "text": "Le joueur peut décider d'explorer le marché de gros et de détail ou la plateforme logistique.",
            "knowledge_kind": "lead",
            "certainty": "tentative",
            "source": "auto_narration",
            "location_id": "halles_des_commerces",
            "linked_entity_ids": [
