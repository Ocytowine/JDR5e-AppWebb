    "narr-pj-1-map-ed6928ae": {
      "campaign_id": "narr-pj-1-map-ed6928ae",
      "clock": {
        "turn_index": 1
      },
      "events": [],
      "relations": [],
      "knowledge": {
        "player_view": [
          {
            "turn_id": "turn-88e88486-d398-409e-8edf-5f1aa56ce6dc",
            "text": "Vous êtes dans les Archives de Lysenthe, un bâtiment civil et historique hautement sécurisé (niveau 82) et d'importance stratégique (87). Ce lieu appartient au Collegium des Archivistes et à la faction des Archivistes de Lysenthe. L'accès est privé, et vous voyez des clercs triant minutieusement des chartes tandis que des gardes veillent aux abords des salles sensibles. Les Archives assurent la conservation des actes et chartes ainsi que la copie et le classement des savoirs administratifs. Ce bâtiment est relié au quartier des Archives et à la place des Archives, tous situés dans la ville portuaire fortifiée de Lysenthe, un ducat gouverné depuis le château Tharqual, foyer d'importants bâtiments comme les Halles des Commerces et la Caserne Centrale.",
            "knowledge_kind": "summary",
            "certainty": "partial",
            "source": "auto_narration",
            "location_id": "archives_de_lysenthe",
            "linked_entity_ids": [
              "archives_de_lysenthe"
            ],
            "tags": [
              "observe",
              "auto_summary"
            ]
          },
          {
            "turn_id": "turn-88e88486-d398-409e-8edf-5f1aa56ce6dc",
            "text": "Vous pouvez interagir avec les clercs ou gardes pour en apprendre davantage.",
            "knowledge_kind": "lead",
            "certainty": "tentative",
            "source": "auto_narration",
            "location_id": "archives_de_lysenthe",
            "linked_entity_ids": [
              "archives_de_lysenthe"
            ],
            "tags": [
              "observe",
              "next_turn_hint"
            ]
          },
          {
            "turn_id": "turn-88e88486-d398-409e-8edf-5f1aa56ce6dc",
            "text": "Explorer les documents ou tenter d'accéder aux zones plus sensibles est une option potentielle.",
            "knowledge_kind": "lead",
            "certainty": "tentative",
            "source": "auto_narration",
            "location_id": "archives_de_lysenthe",
            "linked_entity_ids": [
              "archives_de_lysenthe"
            ],
            "tags": [
              "observe",
              "next_turn_hint"
            ]
          }
        ],
        "truth_view": []
